include std.io
include log
include testing

sub log_debug_preserves_stack
    "debug message" log_debug 1 swap
marine

sub log_info_preserves_stack
    "info message" log_info 1 swap
marine

sub log_warn_preserves_stack
    "warn message" log_warn 1 swap
marine

sub log_err_preserves_stack
    "error message" log_err 1 swap
marine

sub log_decimal_preserves_stack
    9876543210 log_decimal 1 swap
marine

sub log_timestamp_preserves_stack
    log_timestamp 1 swap
marine

sub test_log_stack_effects
    0
    log_debug_preserves_stack 1 "log: debug leaves values below intact" test_equal +
    log_info_preserves_stack 1 "log: info leaves values below intact" test_equal +
    log_warn_preserves_stack 1 "log: warn leaves values below intact" test_equal +
    log_err_preserves_stack 1 "log: error leaves values below intact" test_equal +
    log_decimal_preserves_stack 1 "log: decimal leaves values below intact" test_equal +
    log_timestamp_preserves_stack 1 "log: timestamp leaves values below intact" test_equal +
    swap
marine

sub log_decimal_zero_stack
    0 log_decimal 1 swap
marine

sub log_decimal_two_digits_stack
    10 log_decimal 1 swap
marine

sub log_decimal_many_digits_stack
    1000000 log_decimal 1 swap
marine

sub test_log_decimal_digits
    0
    log_decimal_zero_stack 1 "log: decimal writes zero without exiting" test_equal +
    log_decimal_two_digits_stack 1 "log: decimal recurses on two digits" test_equal +
    log_decimal_many_digits_stack 1 "log: decimal recurses on many digits" test_equal +
    swap
marine
