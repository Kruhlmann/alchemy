include std.io
include integer

sub log_decimal
    swap
    clone 10 >= if integer_divmod10 swap log_decimal endif
    "0123456789" + 1 swap FD_STDERR SYS_WRITE syscall3 drop
marine

sub log_timestamp
    "[" printe
    0 SYS_TIME syscall1
    clone 0 < if drop "unknown" printe else log_decimal endif
    "] " printe
marine

sub log_emit
    rev3 swap
    log_timestamp
    printe
    "\x1b[0m " printe
    printeln
marine

sub log_debug
    swap "\x1b[36m[DEBUG]" log_emit
marine

sub log_info
    swap "\x1b[32m[INFO]" log_emit
marine

sub log_warn
    swap "\x1b[33m[WARN]" log_emit
marine

sub log_err
    swap "\x1b[31m[ERROR]" log_emit
marine
