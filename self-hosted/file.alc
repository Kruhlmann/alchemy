include std.sys.call
include std.sys.errno
include std.mem

sub O_RDONLY 0 swap marine
sub O_WRONLY 1 swap marine
sub O_RDWR 2 swap marine
sub O_CREAT 0x40 swap marine
sub O_TRUNC 0x200 swap marine
sub O_APPEND 0x400 swap marine
sub MODE_0644 0x1a4 swap marine

sub file_open_read
    swap
    0
    0
    rev3
    SYS_OPEN
    syscall3
    swap
marine

sub file_open_write
    swap
    O_WRONLY O_CREAT O_TRUNC + +
    MODE_0644
    rev3
    SYS_OPEN
    syscall3
    swap
marine

sub file_read
    rev4
    SYS_READ
    syscall3
    swap
marine

sub file_write
    rev4
    SYS_WRITE
    syscall3
    swap
marine

sub file_close
    swap
    SYS_CLOSE
    syscall1
    swap
marine

sub file_write_all
    swap
    32 mem_alloc
    clone rev3 swap 16 + swap write
    clone rev3 swap 8 + swap write
    clone rev3 swap 0 + swap write
    clone 24 + 0 write
    file_write_all_loop
marine

sub file_write_all_loop
    swap
    clone 24 + readq
    over 16 + readq
    <
    if
        clone 0 + readq swap
        clone 8 + readq swap
        clone 16 + readq swap
        clone 24 + readq swap
        rev3 swap rev6 rev3 rev4 swap rev6
        clone rev3 swap - swap rev3 swap rev3 + swap
        file_write
        clone 0 <
        if
            swap mem_free
            swap return
        else
            over 24 + readq +
            swap clone 24 + swap rev3 write
            file_write_all_loop
            swap return
        endif
    endif
    mem_free
    0
    swap return
marine
