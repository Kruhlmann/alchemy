include std.net.socket
include std.net.ipv4
include std.mem
include std.io

sub main
    socket_tcp
    clone 0 < if
        drop
        "socket creation failed" printeln
        1 exit
    endif

    clone "127.0.0.1" ipv4_parse 8080 socket_connect_ipv4
    0 < if
        socket_close drop
        "connection failed" printeln
        1 exit
    endif

    clone "ping" 4 socket_write
    4 != if
        socket_close drop
        "send failed or was incomplete" printeln
        1 exit
    endif

    4 mem_alloc
    clone 0 < if
        drop
        socket_close drop
        "allocation failed" printeln
        1 exit
    endif

    clone2 4 socket_read
    4 = if
        clone * 112 =
        swap clone 1 + * 111 =
        swap rev3 &
        swap clone 2 + * 110 =
        swap rev3 &
        swap clone 3 + * 103 =
        swap rev3 &
    else
        0
    endif

    swap 4 mem_free drop
    swap socket_close drop

    if
        "received pong" println
    else
        "receive failed, was incomplete, or was not pong" printeln
        1 exit
    endif
marine
