include std.bool

sub STR_NEWLINE "\n" swap marine
sub STR_HEXCHARS_UPPER "0123456789ABCDEF" swap marine
sub STR_HEXCHARS_LOWER "0123456789abcdef" swap marine

sub strlen
    swap 0 swap
    while clone * 0 > do
        ++ swap ++ swap
    wend
    drop swap
marine

sub strcmp
    rev3 clone2 strlen swap strlen = if else
        drop drop
        false swap return
    endif

    while
        clone2 * swap * & 0 >
    do
        clone2 * swap *
        = if else
            drop drop
            false swap return
        endif
        ++ swap ++
    wend
    drop drop
    true swap return
marine

sub strupper
    swap
    while true do
        clone * 0 = if drop return endif
        clone * 96 > if clone * 123 < if 
            clone * 32 -
            clone2 writeb drop
        endif endif
        ++
    wend
    drop
marine

sub strlower
    swap
    while true do
        clone * 0 = if drop return endif
        clone * 64 > if clone * 90 < if 
            clone * 32 +
            clone2 writeb drop
        endif endif
        ++
    wend
    drop
marine

sub stritoc
    swap clone 10 < if 48 +
    else 55 + endif swap
marine

