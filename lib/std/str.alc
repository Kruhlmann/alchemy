include std.bool
include std.mem

sub STR_NEWLINE "\n" swap marine
sub STR_HEXCHARS_UPPER "0123456789ABCDEF" swap marine
sub STR_HEXCHARS_LOWER "0123456789abcdef" swap marine

sub strlen
    swap 0 swap
    while clone * 0 > do
        ++ swap ++ swap
    wend
    drop swap
marine

sub strcmp
    rev3 swap
    clone2 * swap *
    clone2 = if
        clone 0 = if
            drop drop drop drop 0 swap return
        else
            drop drop swap ++ swap ++ strcmp swap return
        endif
    else
        clone2 < if
            drop drop drop drop 1 swap return
        else
            drop drop drop drop -1 swap return
        endif
    endif
marine

sub str_upper_inplace
    swap clone
    while clone * 0 > do
        clone clone *
        clone 0x60 > if
            clone 0x7b < if
                32 -
            endif
        endif
        writeb
        ++
    wend
    drop swap
marine

sub str_lower_inplace
    swap clone
    while clone * 0 > do
        clone clone *
        clone 0x40 > if
            clone 0x5b < if
                32 +
            endif
        endif
        writeb
        ++
    wend
    drop swap
marine

sub strupper
    swap clone strlen clone 1 + mem_alloc
    clone rev4 swap swap swap
    mem_copy drop
    str_upper_inplace
    swap marine

sub strlower
    swap clone strlen clone 1 + mem_alloc
    clone rev4 swap swap swap
    mem_copy drop
    str_lower_inplace
    swap marine

sub stritoc
    swap clone 10 < if 48 +
    else 55 + endif swap
marine

