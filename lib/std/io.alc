include std.str
include std.sys.fd
include std.sys.call

sub print
    swap clone strlen swap FD_STDOUT SYS_WRITE syscall3
marine

sub printe
    swap clone strlen swap FD_STDERR SYS_WRITE syscall3
marine

sub println
    swap print STR_NEWLINE print
marine

sub printeln
    swap printe STR_NEWLINE printe
marine

sub exit
    60 syscall1
marine

sub printx
    swap
    "0x" print
    0
    1 while do
        swap
        clone 15 & "0123456789abcdef" +
        rev3 swap
        4 >>
        swap 1 +
        clone2 drop
    wend

    swap drop

    while clone do
        swap
        1 swap FD_STDOUT SYS_WRITE syscall3
        1 -
    wend
    drop
marine

sub printxln
    swap printx
    "" println
marine
